# Polymarket copy bot config
# Safe defaults: paper mode + dry run + Bullpen read-only global flag.
PAPER_MODE=true
DRY_RUN=true
BULLPEN_READ_ONLY=true

# Comma-separated Polymarket wallet addresses to copy.
# Example: COPY_WALLETS=0xabc...,0xdef...
COPY_WALLETS=

# Polling and legacy paper sizing knobs.
POLL_INTERVAL_MS=30000
COPY_TRADE_FRACTION=0.25
MAX_PAPER_TRADE_USD=10
MIN_SOURCE_TRADE_USD=1

# Risk engine defaults before any live-trading implementation.
FIXED_COPY_BUY_USD=5
MAX_EXPOSURE_PER_MARKET_USD=25
MAX_TOTAL_OPEN_EXPOSURE_USD=50
MAX_COPIED_TRADES_PER_TRADER_PER_HOUR=3
MAX_COPY_PRICE=0.90
MIN_HOURS_TO_RESOLUTION=24

# Local files and dashboard.
SQLITE_PATH=data/bot.sqlite
TRADES_JSON_PATH=data/trades.json
SELECTED_TRADERS_PATH=data/selected-traders.json
LEADERBOARD_JSON_PATH=data/leaderboard.json
DASHBOARD_PORT=3007
BULLPEN_BIN=bullpen
